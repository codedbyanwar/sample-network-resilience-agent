# Configuration — copy to .env and customize as needed.
# Every value has a sensible default, so nothing here is needed to run locally.
# The exception is the Bedrock Guardrail block at the bottom, which is required
# for production deployments.

# Bedrock model ID. If omitted, us./eu./apac. is auto-added based on region.
# If you set an ID that already includes a prefix (global./us./eu./apac.),
# it is used verbatim.
# VITE_BEDROCK_MODEL_ID=global.anthropic.claude-opus-5

# Default AWS region (used for mock mode and as fallback)
# VITE_DEFAULT_REGION=us-east-1

# Allow-list of regions to scan (comma-separated). When set, discovery is
# restricted to ONLY these regions — every other region is skipped and never
# probed, and the home region is pinned to the first entry. Use this when an
# org Service Control Policy permits only a known set of regions, so the app
# never attempts a denied one. Takes precedence over VITE_EXCLUDED_REGIONS.
# VITE_ALLOWED_REGIONS=ap-southeast-1,ap-southeast-5

# Regions to skip during multi-region discovery (comma-separated). Listed
# regions are never probed, so they produce no per-region fetch errors. Useful
# when an org Service Control Policy denies ec2:Describe* in a region where you
# have no resources (e.g. a region guardrail blocking sa-east-1). Ignored when
# VITE_ALLOWED_REGIONS is set.
# VITE_EXCLUDED_REGIONS=sa-east-1

# Max tool-use rounds per chat turn (default: 5)
# VITE_MAX_TOOL_ROUNDS=5

# Default mock scenario on first load: noResiliency | devTest | high | maximum | crossAccount
# VITE_DEFAULT_SCENARIO=noResiliency

# App title shown in the header
# VITE_APP_TITLE=Network Resilience Agent

# SSO backend URL (from CloudFormation stack output, or http://localhost:3001 for dev)
# VITE_SSO_BACKEND_URL=

# Bedrock Guardrail — REQUIRED FOR PRODUCTION. Leaving it unset is a local-dev
# convenience only; a production build logs a console warning when it is missing.
# The chat agent's context includes resource names and tags, which on cross-account
# setups come from spoke accounts — so a tag value is a prompt-injection vector.
# Create a guardrail in the Bedrock console with prompt attack detection set to High,
# plus sensitive information and content filters, then set the ID and version here.
# See docs/SETUP.md section 8.1.
# VITE_BEDROCK_GUARDRAIL_ID=
# VITE_BEDROCK_GUARDRAIL_VERSION=DRAFT
